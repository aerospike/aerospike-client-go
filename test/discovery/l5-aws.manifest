# Manifest for the l5-aws harness in aerospike-client-conformance (l5-aws/README.md).
# Each command runs with bash on the runner (Amazon Linux 2023) from the repository root.
# L5_SETUP and L5_BUILD are separate shells, so L5_BUILD puts Go back on PATH.
L5_SETUP='arch=$(uname -m); case $arch in x86_64) arch=amd64;; aarch64) arch=arm64;; *) echo "unsupported arch $arch" >&2; exit 2;; esac; curl -fsSL "https://go.dev/dl/go1.23.0.linux-${arch}.tar.gz" -o /tmp/go1.23.0.tgz && sudo rm -rf /usr/local/go && sudo tar -C /usr/local -xzf /tmp/go1.23.0.tgz'
L5_BUILD='export PATH=/usr/local/go/bin:$PATH CGO_ENABLED=0 GOPROXY=https://proxy.golang.org,direct; go test -mod=readonly -c -o l5.test .'
L5_DRIVER='test/discovery/l5_driver.sh'
